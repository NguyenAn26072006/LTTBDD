<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/sm_card" android:padding="10dp" android:layout_marginBottom="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="88dp" android:orientation="horizontal">
        <ImageView android:id="@+id/imgProduct" android:layout_width="88dp" android:layout_height="88dp" android:scaleType="centerCrop" android:src="@drawable/sm_image_placeholder"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
            <TextView android:id="@+id/tvProductName" style="@style/SMProductName" android:text="Giáo trình Java cơ bản"/>
            <TextView android:id="@+id/tvProductPrice" style="@style/SMPrice" android:text="50.000₫"/>
            <TextView android:id="@+id/tvProductStatus" style="@style/SMStatus" android:text="Đang bán"/>
            <TextView android:id="@+id/tvProductMeta" style="@style/SMHint" android:text="Đăng 2 giờ trước · 24 lượt xem"/>
        </LinearLayout>
        <ImageButton android:id="@+id/btnMore" android:layout_width="32dp" android:layout_height="40dp" android:background="@android:color/transparent" android:src="@android:drawable/ic_menu_more" android:contentDescription="Tùy chọn"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal">
        <Button android:id="@+id/btnEditListing" style="@style/SMButtonSmallOutline" android:text="Sửa"/>
        <Button android:id="@+id/btnDeleteListing" style="@style/SMButtonSmallDanger" android:text="Xóa"/>
    </LinearLayout>
</LinearLayout>