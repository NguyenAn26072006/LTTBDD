<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8FC">

    <!-- KHU VỰC NỘI DUNG CÓ THỂ CUỘN -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Student Market"
                        android:textColor="#6548D8"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mua bán thông minh - Tiết kiệm hơn"
                        android:textColor="#777777"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="🔔"
                    android:textSize="21sp"
                    android:background="#FFFFFF" />

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="💬"
                    android:textSize="21sp"
                    android:background="#FFFFFF" />
            </LinearLayout>

            <!-- LỜI CHÀO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Xin chào, Minh Tuấn 👋"
                android:textColor="#202033"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎓 ĐH Bách Khoa TP.HCM"
                android:textColor="#777777"
                android:textSize="13sp" />

            <!-- THANH TÌM KIẾM -->
            <EditText
                android:id="@+id/edtSearch"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_search"
                android:hint="🔍  Tìm giáo trình, laptop, máy tính Casio..."
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textSize="13sp" />

            <!-- BANNER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="155dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_home_banner"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="♻ TIẾT KIỆM &amp; XANH"
                    android:textColor="#D9FFF0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Đồ cũ chất lượng - Giá tốt\ncho sinh viên"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Hơn 1.200 món đồ được truyền lại"
                    android:textColor="#EDEBFF"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_banner_button"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="Khám phá ngay  →"
                    android:textColor="#6045D5"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- DANH MỤC -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Danh mục chính"
                    android:textColor="#202033"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4 nhóm nổi bật"
                    android:textColor="#6548D8"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="#E5E8FF"
                    android:gravity="center"
                    android:text="📚\nSách giáo trình"
                    android:textColor="#292942"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_marginHorizontal="5dp"
                    android:layout_weight="1"
                    android:background="#D8FFF0"
                    android:gravity="center"
                    android:text="💻\nLaptop cũ"
                    android:textColor="#292942"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_marginHorizontal="5dp"
                    android:layout_weight="1"
                    android:background="#E1ECFF"
                    android:gravity="center"
                    android:text="📱\nĐiện thoại"
                    android:textColor="#292942"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="#FFE9DF"
                    android:gravity="center"
                    android:text="🧮\nĐồ học tập"
                    android:textColor="#292942"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- SẢN PHẨM MỚI -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🟢 Sản phẩm mới đăng"
                    android:textColor="#202033"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xem tất cả"
                    android:textColor="#6548D8"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false" />

            <!-- BANNER CỘNG ĐỒNG -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="#EDEBFF"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🛡 Cộng đồng sinh viên xác thực"
                    android:textColor="#4934AE"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Giao dịch trực tiếp tại khuôn viên trường an toàn hơn."
                    android:textColor="#55556A"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- SẢN PHẨM NỔI BẬT -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Sản phẩm nổi bật 🔥"
                android:textColor="#202033"
                android:textSize="17sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerFeatured"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>

    <!-- THANH ĐIỀU HƯỚNG DƯỚI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂\nTrang chủ"
            android:textColor="#6548D8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▦\nDanh mục"
            android:textColor="#777777"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♡\nYêu thích"
            android:textColor="#777777"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♙\nTài khoản"
            android:textColor="#777777"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>