<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="24dp" android:background="@drawable/sm_dialog">
    <TextView android:text="▢" android:textSize="34sp" android:textColor="@color/sm_red" android:gravity="center" android:background="@drawable/sm_icon_circle" android:layout_width="68dp" android:layout_height="68dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Xóa tin đăng?" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/sm_text" android:gravity="center" android:paddingTop="12dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tin đăng sẽ bị xóa vĩnh viễn và người mua không còn thấy sản phẩm này." android:textColor="@color/sm_muted" android:gravity="center" android:paddingTop="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/sm_card" android:padding="8dp" android:layout_marginTop="16dp">
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/sm_image_placeholder"/>
        <LinearLayout android:orientation="vertical" android:paddingStart="10dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tvDeleteProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Giáo trình Java cơ bản"
                android:textStyle="bold"
                android:textColor="@color/sm_text"/>

            <TextView
                android:id="@+id/tvDeleteProductPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="50.000₫"
                android:textColor="@color/sm_blue"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:layout_marginTop="18dp">
        <Button android:id="@+id/btnCancelDelete" style="@style/SMButtonOutline" android:text="Hủy"/>
        <Button android:id="@+id/btnConfirmDelete" style="@style/SMButtonDanger" android:text="Xóa"/>
    </LinearLayout>
</LinearLayout>