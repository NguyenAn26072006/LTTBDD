<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/sm_bg">
    <include layout="@layout/include_top_bar"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView style="@style/SMLabel" android:text="Hình ảnh sản phẩm"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="96dp" android:orientation="horizontal">
                <TextView android:id="@+id/btnAddImage" style="@style/SMImageAdd" android:text="＋ Thêm ảnh"/>
                <TextView style="@style/SMImagePlaceholder" android:text="Ảnh bìa"/>
                <TextView style="@style/SMImagePlaceholder" android:text="＋"/>
            </LinearLayout>
            <TextView style="@style/SMHint" android:text="Ảnh đầu tiên sẽ là ảnh bìa của tin đăng."/>
            <TextView style="@style/SMLabel" android:text="Tên sản phẩm *"/>
            <EditText android:id="@+id/edtProductName" style="@style/SMInput" android:hint="Nhập tên sản phẩm" android:singleLine="true"/>
            <TextView style="@style/SMLabel" android:text="Danh mục *"/>
            <Spinner
                android:id="@+id/spCategory"
                style="@style/SMInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView style="@style/SMLabel" android:text="Giá bán *"/>
            <EditText android:id="@+id/edtPrice" style="@style/SMInput" android:hint="Nhập giá bán" android:inputType="numberDecimal"/>
            <TextView style="@style/SMLabel" android:text="Tình trạng hàng hóa *"/>
            <RadioGroup android:id="@+id/rgCondition" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <RadioButton android:id="@+id/rbNew" style="@style/SMRadio" android:text="Mới 100%"/>
                <RadioButton android:id="@+id/rbUsedGood" style="@style/SMRadio" android:text="Đã dùng 90-99%"/>
                <RadioButton android:id="@+id/rbUsed" style="@style/SMRadio" android:text="Dưới 90%"/>
            </RadioGroup>
            <TextView style="@style/SMLabel" android:text="Mô tả sản phẩm"/>
            <EditText android:id="@+id/edtDescription" style="@style/SMInputMulti" android:hint="Mô tả sản phẩm..." android:gravity="top" android:inputType="textMultiLine" android:maxLength="500"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout style="@style/SMBottomActions">
        <Button android:id="@+id/btnSaveDraft" style="@style/SMButtonOutline" android:text="Lưu nháp"/>
        <Button android:id="@+id/btnSell" style="@style/SMButtonPrimary" android:text="Đăng bán"/>
    </LinearLayout>
</LinearLayout>